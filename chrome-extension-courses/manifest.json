{
  "manifest_version": 3,
  "name": "Courses Magiques — assistant magasin",
  "version": "1.6.0",
  "description": "Assistant de courses pour Carrefour, Picard, Monoprix, Leclerc Drive, Auchan et Intermarché.",
  "content_scripts": [
    {
      "matches": [
        "*://*.carrefour.fr/*",
        "*://*.picard.fr/*",
        "*://*.monoprix.fr/*",
        "*://*.leclercdrive.fr/*",
        "*://lesrecettesmagiques.fr/*",
        "*://www.lesrecettesmagiques.fr/*",
        "*://*.vercel.app/*",
        "http://localhost/*",
        "*://*.auchan.fr/*",
        "*://*.intermarche.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
