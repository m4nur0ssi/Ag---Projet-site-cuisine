{
  "name": "les-recettes-magiques",
  "version": "18.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:home-data && concurrently \"next dev\" \"npm run bot\"",
    "dev:ui": "npm run build:home-data && next dev",
    "bot": "node tiktok-bot/server.js",
    "clean-build": "npm run clean && next build",
    "clean": "rd /s /q .next out 2>nul || (exit 0)",
    "build:ext": "cd chrome-extension-courses && zip -r -X ../public/courses-magiques-extension.zip manifest.json content.js content.css",
    "prebuild": "npm run build:home-data && (npm run build:ext || exit 0)",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync-recipes": "node sync-recipes.js",
    "build:home-data": "node scripts/build-home-data.js",
    "photos:push": "bash scripts/pousser-photos.sh",
    "photo:refaire": "bash scripts/refaire-photo.sh",
    "wp:verifier": "node scripts/verifier-wordpress.js",
    "nutri:verifier": "node scripts/verifier-nutriscore.js"
  },
  "dependencies": {
    "@notionhq/client": "^5.9.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "form-data": "^4.0.0",
    "framer-motion": "^12.35.2",
    "next": "^14.1.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.13",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^8.2.2",
    "eslint": "^8",
    "eslint-config-next": "^14.1.0",
    "typescript": "^5"
  }
}
